[Container]
# Multi-arch image; ARM64 is pulled automatically
Image=ghcr.io/nijhum-in/nijhum-api:main
PublishPort=3000:3000
Network=nijhum.network
UserNS=keep-id

Environment=HOME=/home/rocky
Environment=AWS_CONFIG_FILE=/home/rocky/.aws/config
Environment=AWS_PROFILE=rolesanywhere
Environment=REDIS_URL=redis://{{ oci_private_ip }}:6379
Environment=PRIMARY_TABLE={{ dynamodb_identity_table | default('nijhum-identity') }}
Environment=GSI_LOOKUP_INDEX=lookup
Environment=AWS_REGION=ap-south-1
Environment=GOOGLE_CLIENT_ID={{ nijhum_google_client_id }}
Environment=GOOGLE_CLIENT_SECRET={{ nijhum_google_client_secret }}
Environment=GOOGLE_REDIRECT_URI={{ nijhum_google_redirect_uri }}

Volume=%h/.aws/config:/home/rocky/.aws/config:ro,Z
Volume=/usr/local/bin/aws_signing_helper:/usr/local/bin/aws_signing_helper:ro
Volume=%h/.aws/certs:/home/rocky/.aws/certs:ro,Z

[Service]
Restart=always

[Install]
WantedBy=default.target
