[profile rolesanywhere]
credential_process = /usr/local/bin/aws_signing_helper credential-process --certificate /home/rocky/.aws/certs/cert.pem --private-key /home/rocky/.aws/certs/key.pem --trust-anchor-arn {{ aws_trust_anchor_arn }} --profile-arn {{ aws_profile_arn }} --role-arn {{ aws_role_arn }}
