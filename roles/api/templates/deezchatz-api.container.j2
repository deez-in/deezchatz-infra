[Container]
ContainerName={{ api_container_name | default('deezchatz-api') }}
# Multi-arch image; ARM64 is pulled automatically
Image=ghcr.io/deez-in/deezchatz-api:{{ api_image_tag | default('latest') }}
PublishPort=3000:3000
Network=deezchatz.network
UserNS=keep-id

Environment=HOME={{ ansible_facts['user_dir'] }}
Environment=AWS_CONFIG_FILE={{ ansible_facts['user_dir'] }}/.aws/config
Environment=AWS_PROFILE=rolesanywhere
Environment=REDIS_URL=redis://{{ oci_private_ip }}:6379
Environment=PRIMARY_TABLE={{ dynamodb_identity_table | default('deezchatz-identity-table') }}
Environment=GSI_LOOKUP_INDEX={{ gsi_lookup_index | default('lookup') }}
Environment=AWS_REGION={{ aws_region | default('ap-south-1') }}
Environment=GOOGLE_CLIENT_ID={{ deez_google_client_id }}
Environment=GOOGLE_CLIENT_SECRET={{ deez_google_client_secret }}
Environment=GOOGLE_REDIRECT_URI={{ deez_google_redirect_uri }}
Environment=FCM_PROJECT_ID={{ fcm_project_id }}
Environment=FCM_SERVICE_ACCOUNT_KEY_PATH={{ ansible_facts['user_dir'] }}/.config/deezchatz/fcm-service-account.json

Volume=%h/.aws/config:{{ ansible_facts['user_dir'] }}/.aws/config:ro,Z
Volume=/usr/local/bin/aws_signing_helper:/usr/local/bin/aws_signing_helper:ro
Volume=%h/.aws/certs:{{ ansible_facts['user_dir'] }}/.aws/certs:ro,Z
Volume=%h/.config/deezchatz/fcm-service-account.json:{{ ansible_facts['user_dir'] }}/.config/deezchatz/fcm-service-account.json:ro,Z

[Service]
Restart=always

[Install]
WantedBy=default.target
