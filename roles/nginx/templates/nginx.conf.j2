user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    # Map allowed CORS origins for web endpoints
    map $http_origin $cors_origin {
        default "";
{% if cors_allowed_origins is defined -%}
{% for origin in cors_allowed_origins %}
        "{{ origin }}" "$http_origin";
{% endfor -%}
{% else -%}
        "~^https?://(.*\.)?deez\.in(:[0-9]+)?$" "$http_origin";
        "~^https?://localhost:8787$" "$http_origin";
        "~^https?://127\.0\.0\.1:8787$" "$http_origin";
{% endif %}
    }


    # Redirect all HTTP traffic to HTTPS, except ACME challenges
    server {
        listen       80;
        listen  [::]:80;
        server_name  {{ api_domain_name }} {{ mqtt_domain_name | default('') }};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # API HTTPS termination
    server {
        listen       443 ssl;
        listen  [::]:443 ssl;
        server_name  {{ api_domain_name }};

        ssl_certificate     /etc/letsencrypt/live/{{ api_domain_name }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ api_domain_name }}/privkey.pem;

        # Let's Encrypt / Mozilla strict settings
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        # Web endpoint for Google OAuth account deletion (CORS enabled)
        location = /users/me/oauth {
            # CORS Preflight Handling
            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Access-Control-Allow-Methods' 'DELETE, OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Content-Type, Accept, Origin, X-Requested-With' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                add_header 'Content-Type' 'text/plain; charset=utf-8';
                add_header 'Content-Length' 0;
                return 204;
            }

            # Response CORS Headers for actual requests
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Access-Control-Allow-Methods' 'DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Accept, Origin, X-Requested-With' always;

            # Proxy to DeezChatz API listening on host port 3000
            proxy_pass http://host.containers.internal:3000;
            
            # Preserve headers
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Mobile and default API endpoints (No CORS headers)
        location / {
            # Proxy to DeezChatz API listening on host port 3000
            proxy_pass http://host.containers.internal:3000;
            
            # Preserve headers
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}

# Stream block for RMQTT MQTTS (TCP TLS to TCP proxy)
stream {
    server {
        listen       8883 ssl;
        listen  [::]:8883 ssl;

        ssl_certificate     /etc/letsencrypt/live/{{ mqtt_domain_name | default(api_domain_name) }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ mqtt_domain_name | default(api_domain_name) }}/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        # Proxy decrypted MQTT traffic to RMQTT listening on host port 1883
        proxy_pass host.containers.internal:1883;
    }
}
